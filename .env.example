# Local PostgreSQL (docker compose / pnpm db:up)
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/playable_factory
PORT=4000

# Gemini (used by ingestion, search and chat; not required for pnpm run setup)
# Replace with your current key when you are ready to index the corpus.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.6-flash

# Corpus
CORPUS_PATH=corpus

# Retrieval: balanced dense/lexical candidates; dense and rrf remain available.
RETRIEVAL_MODE=hybrid

# Authentication (set a long random secret for local login)
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Optional local MCP server (use the same token for API and MCP)
MCP_API_BASE_URL=http://127.0.0.1:4000
MCP_SERVICE_TOKEN=

# Frontend (Next.js also reads this root .env file)
NEXT_PUBLIC_API_URL=http://localhost:4000

# CORS
CORS_ORIGIN=http://localhost:3000

# Portfolio mode is opt-in locally. See docs/RAILWAY_DEPLOYMENT.md for production.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
# For demo: use a NEW database, set CORPUS_PATH=demo-corpus and set its exact name.
DEMO_DATABASE_NAME=
DEMO_DAILY_GEMINI_CALL_LIMIT=40
DEMO_MINUTE_GEMINI_CALL_LIMIT=6
DATABASE_POOL_MAX=3
DATABASE_IDLE_TIMEOUT_MS=5000
QUERY_EMBEDDING_CACHE_TTL_MS=900000
QUERY_EMBEDDING_CACHE_MAX_ENTRIES=128
RAG_RESPONSE_CACHE_TTL_MS=300000
RAG_RESPONSE_CACHE_MAX_ENTRIES=32
RAG_DIAGNOSTICS=false
# Set to 1 only when the API is reachable exclusively through Railway's proxy.
TRUST_PROXY_HOPS=0
