{
  "name": "@playable-factory/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "tsx --test src/tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test:embedding": "tsx src/scripts/test-embedding.ts",
    "test:corpus": "tsx src/scripts/test-corpus.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "test:retrieval": "tsx src/scripts/test-retrieval.ts",
    "test:rag": "tsx src/scripts/test-rag.ts",
    "test:evaluation": "tsx src/evaluation/retrieval-evaluation.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "test:evaluation:v2": "tsx src/evaluation/retrieval-evaluation-v2.ts",
    "test:rag:evaluation": "tsx src/evaluation/rag-evaluation.ts",
    "test:evaluation:v3": "tsx src/evaluation/retrieval-evaluation-v3.ts",
    "test:rag:evaluation:v3": "tsx src/evaluation/rag-evaluation-v3.ts",
    "test:rag:evaluation:v4": "tsx src/evaluation/rag-evaluation-v4.ts",
    "test:query-rewrite": "tsx src/scripts/test-query-rewrite.ts",
    "test:retrieval:multi": "tsx src/scripts/test-retrieval-multi-query.ts"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@playable-factory/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
